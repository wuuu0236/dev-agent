DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- 推理后端：cloud(默认, 走 DeepSeek) | ollama(本地私有化/离线) ---
LLM_BACKEND=cloud
# 本地 Ollama 后端（LLM_BACKEND=ollama 时生效）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_LLM_MODEL=qwen2.5:7b
# 视觉模型：填了(如 minicpm-v:8b)才在命中图片块时调用本地视觉模型真·看图；留空则图片只用 OCR 文字
OLLAMA_VISION_MODEL=

# --- Embedding 后端：cloud(默认, 硅基流动 API) | ollama(本地 nomic-embed-text, 完全离线) ---
EMBEDDING_BACKEND=cloud
OLLAMA_EMBED_MODEL=nomic-embed-text

# ⚠️ EMBEDDING_API_KEY 必须单独填，不能指望它复用 LLM 的 key！
#    Embedding 走硅基流动、LLM 走 DeepSeek —— 两家 key 不通用。
#    不填时 config 会回退成 DEEPSEEK_API_KEY 去请求硅基流动，**必然 401**，
#    而且报错信息不会指向这一行，排查起来很绕。
EMBEDDING_API_KEY=your_siliconflow_api_key_here
# 默认已是硅基流动，只有在自建 / 换服务商时才需要改。
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# ⚠️ 换模型要同时改 src/config.py 的 EMBEDDING_DIM（当前写死 1024），
#    并且必须用「重建索引」重跑已有知识库 —— 老向量是旧模型算的，混在一起不可比。
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# --- 多模态 OCR：是否对图片/扫描版PDF做本地 RapidOCR（默认开） ---
ENABLE_OCR=true

# --- 检索：召回（BM25 关键词 + 稠密向量，RRF 融合）---
# 两路各给一个权重：score = VECTOR_WEIGHT/(60+向量排名) + BM25_WEIGHT/(60+关键词排名)
# 某一路设为 0 即关闭该路（BM25_WEIGHT=0 时连索引都不建）。
# 为什么默认两路都开：向量擅长语义、BM25 擅长专有名词（Dockerfile、基金代码等），互补。
# 做 A/B 时只切这一个变量：BM25_WEIGHT=0 python scripts/eval_retrieval.py --no-archive
BM25_WEIGHT=1
VECTOR_WEIGHT=1
# 候选池：粗排先捞多少条交给精排（0 = 自动 top_k*10）。融合后会截断到这个大小，
# 所以池子大小 = 精排的账单规模，与开了几路召回无关。
RETRIEVE_CANDIDATES=0

# --- 检索：精排（交叉编码 bge-reranker-v2-m3，默认开）---
# 实测四项全涨：Recall@5 0.960→1.000 / Hit@1 0.840→0.920 / MRR 0.887→0.960。
# 代价是每次检索多一次 API 调用。跑无精排的对照：RERANK_ENABLED=false
RERANK_ENABLED=true
# 精排默认复用 Embedding 的 key 与端点（同为硅基流动），通常不用配。
# ⚠️ 要覆盖就得填**非空值**：写成 `RERANK_API_KEY=` 会把变量设成空串，
#    os.getenv 见到变量存在就不再走默认值，精排会因拿空 key 而失败。
# RERANK_API_KEY=
# RERANK_API_BASE=
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 检索：质量门控（阈值拒答，默认开）---
# 精排最高分低于该阈值就不把上下文喂给模型，改由无依据提示词如实说"知识库中没有找到"。
# 阈值建在精排分数上（有绝对意义）；设为 0 或负数即关闭。
RETRIEVAL_MIN_SCORE=0.3

# --- 查询改写（多轮追问消解，默认开）---
# 多轮追问「那第二点呢」直接检索是捞不到的，先改写成一句自包含查询再检索。
# 单轮提问零成本跳过。要跑对照设 false。
QUERY_REWRITE_ENABLED=true

# --- 语义缓存：重复/相似问题命中缓存秒回（默认开）。阈值越高越保守(易漏),越低越激进(易误命中) ---
QUERY_CACHE_ENABLED=true
QUERY_CACHE_THRESHOLD=0.90

# --- 问答日志：反馈环 P0 黑匣子（默认开）---
# 每次问答落一条现场快照（检索 query / 命中片段 / 最高精排分 / 门控是否拦下），
# 在「评估面板 → 问答日志」里汇总。RAG 的失败不可自证——检索没命中和库里根本没有
# 在系统内部长得一模一样，没有快照就无法归因，用户说"这条答错了"你也看不出为什么。
# 独立价值：不需要任何用户操作，grounded=0 的记录天然是一份「问了但没撑住」的清单。
ANSWER_LOG_ENABLED=true
# 每库上限，超限后按规则淘汰。**淘汰会跳过被评价过的记录**（那是信号，不是垃圾），
# 所以实际条数可能略超这个值——这是有意的，宁可多占几 KB 也不丢信号。
ANSWER_LOG_MAX_PER_KB=500
# 单条快照最多存几条命中 / 每条命中的片段长度（控制 SQLite 体积）。
# 调大能看到更完整的检索现场，代价是库文件变大。
ANSWER_LOG_MAX_HITS=8
ANSWER_LOG_HIT_CHARS=200

# --- Langfuse 观测 ---
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# ⚠️ 变量名必须是 LANGFUSE_HOST —— 这是 langfuse SDK 自己读的名字。
#    写成 LANGFUSE_BASE_URL 不会报错，但**会被完全忽略**、静默回落到本默认值，
#    自建 / 换区域时表现为"配置改了却没生效"。（v2.50 源码里只有 LANGFUSE_HOST）
LANGFUSE_HOST=https://cloud.langfuse.com

# --- 认证与权限（多用户，src/auth/）---
# 登录 token 签名密钥。⚠️ 下面这个默认值写在源码里 = 任何人都能自己签合法 token，
#   只要部署可能被外网访问，就**必须**换成一个长随机串（如 python -c "import secrets; print(secrets.token_urlsafe(48))"）。
JWT_SECRET=datalens-dev-secret-do-not-use-in-prod
# token 有效期（小时）
JWT_EXPIRE_HOURS=72
# 首次启动建默认管理员用（users 表为空时自动创建，并认领所有无主知识库）。
# ⚠️ changeme 是弱口令，外网部署前必须改。仅对「首次建管理员」生效——
#   账号已存在后再改这两个变量，不会改变已有账号的密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- 高相似直接返回（跳过 LLM，默认关）---
# 精排最高分超过阈值时，不调 LLM，直接把 top1 原文作为答案返回：
# 省一次调用（延迟+账单），且原文即答案 = 零幻觉。代价是回答为原文照搬，
# 没有针对问题的综合与语气。阈值必须显著高于门控 RETRIEVAL_MIN_SCORE（0.3）：
# 门控管「能不能答」，这里管「答案已经白给到不用答」。
DIRECT_RETURN_ENABLED=false
DIRECT_RETURN_THRESHOLD=0.92

# --- Contextual Retrieval（入库前给 chunk 生成文档级上下文，默认关）---
# 入库时用 LLM 给每个 chunk 生成一句「这个片段在整篇文档里的位置和语境」，
# 以 `[描述] ` 前缀拼在内容前再嵌入，半截语境的 chunk 不再仅凭字面误命中
# （Anthropic 实测能显著降低检索失败率）。检索阶段零额外开销。
# ⚠️ 成本：入库时每个 chunk 一次 LLM 调用（时间与账单随 chunk 数线性增长），
# 适合"传一次、查很久"的库；频繁换文档的库慎开。
# 开启后建议重传/重建索引：老索引不含前缀，开关只对**新入库**的 chunk 生效。
CONTEXTUAL_RETRIEVAL_ENABLED=false
CONTEXTUAL_MODEL=deepseek-chat
# 送审的"整篇文档"截断长度（字符）：超过部分不发给 LLM，防长文档把账单抬高
CONTEXTUAL_DOCUMENT_MAX_CHARS=8000

# --- Multi-Query 查询扩展（检索侧，默认关）---
# 检索前把问题改写成 N 个不同角度的等价表述各召回一路，RRF 跨查询融合后
# 精排只做一次（精排账单不变）。弥补单一表述召不全：向量检索对措辞敏感，
# 多角度能把"换个说法就召不到"的方差平均掉。代价：每问多一次 LLM 调用。
# 仅作用于检索；前端展示的改写问句仍是 query_rewrite 的单个结果。
QUERY_EXPANSION_ENABLED=false
# 含原始 query 在内的总查询数（建议 3-5：太少扩不出角度，太多粗排线性变慢）
QUERY_EXPANSION_COUNT=3

# --- CRAG 生成后自检（默认关）---
# 答案生成后让模型判断「答案是否真的基于上下文」（1-5 分），低于阈值就用
# 更严格的 prompt 重试一次（取分高者）。与检索侧门控分工：门控管进门
# （分数不够不喂模型），自检管出门（查答案有没有编）。验证失败即放行。
# 成本：每问多一次打分调用（max_tokens=5）；低于阈值才付一次完整重试生成。
ANSWER_VERIFY_ENABLED=false
# 低于该分（1-5）触发严格重试；设为 1 等于"只打分不重试"
ANSWER_VERIFY_THRESHOLD=3

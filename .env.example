DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- 推理后端：cloud(默认, 走 DeepSeek) | ollama(本地私有化/离线) ---
LLM_BACKEND=cloud
# 本地 Ollama 后端（LLM_BACKEND=ollama 时生效）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_LLM_MODEL=qwen2.5:7b
# 视觉模型：填了(如 minicpm-v:8b)才在命中图片块时调用本地视觉模型真·看图；留空则图片只用 OCR 文字
OLLAMA_VISION_MODEL=

# --- Embedding 后端：cloud(默认, 硅基流动 API) | ollama(本地 nomic-embed-text, 完全离线) ---
EMBEDDING_BACKEND=cloud
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- 多模态 OCR：是否对图片/扫描版PDF做本地 RapidOCR（默认开） ---
ENABLE_OCR=true

# --- 检索：召回（BM25 关键词 + 稠密向量，RRF 融合）---
# 两路各给一个权重：score = VECTOR_WEIGHT/(60+向量排名) + BM25_WEIGHT/(60+关键词排名)
# 某一路设为 0 即关闭该路（BM25_WEIGHT=0 时连索引都不建）。
# 为什么默认两路都开：向量擅长语义、BM25 擅长专有名词（Dockerfile、基金代码等），互补。
# 做 A/B 时只切这一个变量：BM25_WEIGHT=0 python scripts/eval_retrieval.py --no-archive
BM25_WEIGHT=1
VECTOR_WEIGHT=1
# 候选池：粗排先捞多少条交给精排（0 = 自动 top_k*10）。融合后会截断到这个大小，
# 所以池子大小 = 精排的账单规模，与开了几路召回无关。
RETRIEVE_CANDIDATES=0

# --- 检索：精排（交叉编码 bge-reranker-v2-m3，默认开）---
# 实测四项全涨：Recall@5 0.960→1.000 / Hit@1 0.840→0.920 / MRR 0.887→0.960。
# 代价是每次检索多一次 API 调用。跑无精排的对照：RERANK_ENABLED=false
RERANK_ENABLED=true

# --- 检索：质量门控（阈值拒答，默认开）---
# 精排最高分低于该阈值就不把上下文喂给模型，改由无依据提示词如实说"知识库中没有找到"。
# 阈值建在精排分数上（有绝对意义）；设为 0 或负数即关闭。
RETRIEVAL_MIN_SCORE=0.3

# --- 查询改写（多轮追问消解，默认开）---
# 多轮追问「那第二点呢」直接检索是捞不到的，先改写成一句自包含查询再检索。
# 单轮提问零成本跳过。要跑对照设 false。
QUERY_REWRITE_ENABLED=true

# --- 语义缓存：重复/相似问题命中缓存秒回（默认开）。阈值越高越保守(易漏),越低越激进(易误命中) ---
QUERY_CACHE_ENABLED=true
QUERY_CACHE_THRESHOLD=0.90

# --- Langfuse 观测 ---
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
